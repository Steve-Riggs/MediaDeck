{
  "name": "mediadeck-card",
  "version": "0.1.0-alpha.1",
  "description": "A media-first Home Assistant Lovelace card for unified TV and streaming control.",
  "type": "module",
  "files": ["dist/mediadeck.js"],
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts vitest.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \".github/**/*.yml\" README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \".github/**/*.yml\" README.md"
  },
  "dependencies": {
    "lit": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
